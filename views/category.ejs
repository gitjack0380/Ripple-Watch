<%- include('partials/head', {title:'栏目 · '+cat}) %>
<%- include('partials/header') %>

<div class="container">
  <div class="note">🔧 完整产品（测试模式）。栏目页按分类聚合信息流，付费墙同样生效。</div>

  <div class="section-title" style="margin-top:28px"><h2><%= cat %> · 全球大事的普通人视角</h2><span class="line"></span></div>

  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px">
    <a href="/category" class="tag cat" style="cursor:pointer">全部</a>
    <% ['时政','经济','科技','气候','生活'].forEach(function(c){ %><a href="/category/<%= c %>" class="tag" style="background:var(--bg);color:var(--muted);cursor:pointer"><%= c %></a><% }); %>
  </div>

  <div class="grid">
    <main>
      <div class="feed">
        <% if(list.length===0){ %><p style="color:var(--muted)">该栏目暂无内容。</p><% } %>
        <% list.forEach(function(a){ %>
        <article class="card">
          <div class="meta"><span class="tag cat"><%= a.category %></span><span><%= a.date %></span><span>· 阅读 <%= (a.views||0).toLocaleString() %></span><% if(a.isPremium){ %><span class="tag member">会员专享</span><% } %></div>
          <h3><%= a.title %><% if(a.isPremium){ %><span class="lock">🔒</span><% } %></h3>
          <p><%- a.freeHtml.replace(/<[^>]+>/g,'').slice(0,70) %>…</p>
          <div class="impacts"><% (a.impacts||[]).forEach(function(im){ %><span class="impact <%= im.t %>"><%= im.l %></span><% }); %></div>
          <a href="/article/<%= a.id %>" class="read">阅读全文 →</a>
        </article>
        <% }); %>
      </div>
      <%- adHtml('feed') %>
    </main>
    <aside class="sidebar">
      <div class="widget"><h4>📊 本栏影响指数</h4>
        <div class="index-bar">
          <div class="index-row"><span class="label">物价</span><span class="bar"><i style="width:62%;background:var(--up)"></i></span><span>中高</span></div>
          <div class="index-row"><span class="label">出行</span><span class="bar"><i style="width:40%;background:var(--impact)"></i></span><span>中</span></div>
          <div class="index-row"><span class="label">就业</span><span class="bar"><i style="width:48%;background:var(--brand)"></i></span><span>中</span></div>
        </div>
      </div>
      <div class="widget"><h4>🔥 本栏热门</h4>
        <div class="mini-list"><% list.slice(0,3).forEach(function(a,i){ %><div class="mini-item"><span class="n"><%= i+1 %></span><a href="/article/<%= a.id %>"><%= a.title.slice(0,16) %>…</a></div><% }); %></div>
      </div>
      <%- adHtml('sidebar') %>
    </aside>
  </div>
</div>

<%- include('partials/footer') %>
