<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="logo"><span class="mark">涟</span><span><%= siteName %><small>RIPPLE WATCH</small></span></a>
    <nav class="nav-links">
      <a href="/" class="<%= typeof active!=='undefined' && active==='home'?'active':'' %>">首页</a>
      <a href="/category/时政">时政</a>
      <a href="/category/经济">经济</a>
      <a href="/category/科技">科技</a>
      <a href="/category/气候">气候</a>
      <a href="/category/生活">生活</a>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %><a href="/admin" class="nav-admin">管理后台</a><% } %>
    </nav>
    <div class="nav-right">
      <label class="search"><span>🔍</span><input placeholder="搜索大事影响…"></label>
      <% if(user){ %>
        <span style="font-size:13px;color:var(--muted)"><%= user.account %></span>
        <% if(isMember){ %><span class="tag member">会员</span><% } %>
        <button class="btn btn-ghost" data-action="logout">退出</button>
      <% } else { %>
        <a href="/login" class="btn btn-ghost">登录</a>
      <% } %>
      <a href="/membership" class="btn btn-primary">开通会员</a>
    </div>
  </div>
</header>
