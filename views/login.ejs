<%- include('partials/head', {title:'登录 / 注册'}) %>
<%- include('partials/header') %>

<div class="container">
  <div style="max-width:420px;margin:50px auto">
    <div class="plan" style="padding:32px">
      <h3 style="text-align:center;font-size:22px">欢迎来到 <%= siteName %></h3>
      <p style="text-align:center;color:var(--muted);font-size:13px;margin:6px 0 22px"><%= siteSlogan %></p>
      <form id="auth-form">
        <input type="hidden" id="auth-mode" name="mode" value="login">
        <label style="display:block;font-size:13px;color:var(--muted);margin-bottom:6px">账号（手机号或邮箱）</label>
        <input name="account" required style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;font-size:15px;margin-bottom:16px;outline:none">
        <label style="display:block;font-size:13px;color:var(--muted);margin-bottom:6px">密码（≥6 位）</label>
        <input name="password" type="password" required minlength="6" style="width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;font-size:15px;margin-bottom:22px;outline:none">
        <button id="auth-submit" class="btn btn-primary btn-block" type="submit">登录</button>
      </form>
      <p style="text-align:center;margin-top:16px;font-size:13px;color:var(--muted)">
        <a href="#" id="auth-switch" style="color:var(--brand);font-weight:600">没有账号？去注册</a>
      </p>
      <p style="text-align:center;margin-top:10px;font-size:12px;color:#94A3B8">测试模式：可随意注册体验，数据保存在本地。</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
