# 环境变量示例（复制为 .env 本地用，或参考在 Render 控制台逐项填写）
# 生产部署请把 .env 加入 .gitignore（已默认忽略），切勿提交真实密钥

# 运行模式
NODE_ENV=production

# 监听端口（Render 会自动注入 PORT，本地可自定义）
PORT=3000

# 数据目录：本地默认 ./data；Render 持久盘挂载点设为 /var/data
DATA_DIR=/var/data

# AI 模型 Key（ModelScope DeepSeek-V4-Pro）
# 在 https://modelscope.cn 的「模型推理」中获取 API Key
LLM_API_KEY=ms-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖 config.json 里的管理后台密钥（留空则用 config.json 默认值）
# ADMIN_KEY=

# 可选：小鹅通支付校验密钥（接真实订单回调时使用）
# XIAOE_TOKEN=
